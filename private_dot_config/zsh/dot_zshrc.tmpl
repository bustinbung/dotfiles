# vim: set ft=sh:
# load antidote plugins
{{ if eq .chezmoi.os "darwin" -}}
source $(brew --prefix)/opt/antidote/share/antidote/antidote.zsh
{{ else if eq .chezmoi.os "linux" -}}
source ~/.config/zsh/.antidote/antidote.zsh
{{ end -}}
antidote load ${ZDOTDIR}/.zplugins

# set ZLE vi mode
bindkey -v

# search history by substring
bindkey "$terminfo[kcuu1]" history-substring-search-up
bindkey "$terminfo[kcud1]" history-substring-search-down

# aliases
alias ls="ls --color=auto -1AFh"
alias ll="ls --color=auto -laFh"

# zoxide
eval "$(zoxide init zsh --cmd cd)"

# fnm
{{ if eq .chezmoi.os "darwin" -}}
FNM_PATH="/opt/homebrew/opt/fnm/bin"
{{ end -}}
if [ -d "$FNM_PATH" ]; then
  eval "$(fnm env --shell zsh --use-on-cd --version-file-strategy=recursive)"
fi
