# Modes
:: window @ : borders active_color=0xff9ccfd8
:: service @ : borders active_color=0xffeb6f92
:: default : borders active_color=0xffc4a7e7

# Window
meh - w ; window
window < escape ; default
window < meh - w ; default

meh - h : nehirctl command focus left
meh - j : nehirctl command focus down
meh - k : nehirctl command focus up
meh - l : nehirctl command focus right
window < h : nehirctl command focus left
window < j : nehirctl command focus down
window < k : nehirctl command focus up
window < l : nehirctl command focus right

meh + cmd - h : nehirctl command move-column left
meh + cmd - j : nehirctl command move-column down
meh + cmd - k : nehirctl command move-column up
meh + cmd - l : nehirctl command move-column right
window < cmd - h : nehirctl command move-column left
window < cmd - j : nehirctl command move-column down
window < cmd - k : nehirctl command move-column up
window < cmd - l : nehirctl command move-column right

meh - f : nehirctl command toggle-column-full-width
window < f : nehirctl command toggle-column-full-width

# meh - c : paneru send-cmd window center
# window < c : paneru send-cmd window center

# meh - r : paneru send-cmd window resize
# window < r : paneru send-cmd window resize

# minus
meh - 0x1b : nehirctl command cycle-column-width backward
# plus
meh - 0x18 : nehirctl command cycle-column-width forward

meh - m : nehirctl command toggle-focused-window-floating
window < m : nehirctl command toggle-focused-window-floating

# comma
meh - 0x2b : nehirctl command consume-window-into-column
# period
meh - 0x2f : nehirctl command expel-window-from-column
# left bracket
meh - 0x21 : nehirctl command consume-or-expel-window-left
# right bracket
meh - 0x1e : nehirctl command consume-or-expel-window-right
# slash
meh - 0x2c : nehirctl command balance-sizes
window < 0x2b : nehirctl command consume-window-into-column
window < 0x2f : nehirctl command expel-window-from-column
window < 0x2c : nehirctl command balance-sizes
window < 0x21 : nehirctl command consume-or-expel-window-left
window < 0x1e : nehirctl command consume-or-expel-window-right

# Workspaces
meh - 1 : nehirctl command switch-workspace 1
meh - 2 : nehirctl command switch-workspace 2
meh - 3 : nehirctl command switch-workspace 3
meh - 4 : nehirctl command switch-workspace 4
meh - 5 : nehirctl command switch-workspace 5
meh - 6 : nehirctl command switch-workspace 6
meh - 7 : nehirctl command switch-workspace 7
meh - 8 : nehirctl command switch-workspace 8
meh - 9 : nehirctl command switch-workspace 9
meh - 0 : nehirctl command switch-workspace 10

meh - pageup : nehirctl command switch-workspace prev
meh - pagedown : nehirctl command switch-workspace next
meh - i : nehirctl command switch-workspace prev
meh - u : nehirctl command switch-workspace next

meh + cmd - 1 : nehirctl command move-to-workspace 1
meh + cmd - 2 : nehirctl command move-to-workspace 2
meh + cmd - 3 : nehirctl command move-to-workspace 3
meh + cmd - 4 : nehirctl command move-to-workspace 4
meh + cmd - 5 : nehirctl command move-to-workspace 5
meh + cmd - 6 : nehirctl command move-to-workspace 6
meh + cmd - 7 : nehirctl command move-to-workspace 7
meh + cmd - 8 : nehirctl command move-to-workspace 8
meh + cmd - 9 : nehirctl command move-to-workspace 9
meh + cmd - 0 : nehirctl command move-to-workspace 10

meh + cmd - pageup : nehirctl command move-to-workspace up
meh + cmd - pagedown : nehirctl command move-to-workspace down
meh + cmd - i : nehirctl command move-to-workspace up
meh + cmd - u : nehirctl command move-to-workspace down

# Apps
meh - t : osascript -e 'tell application "Ghostty"' -e 'new window' -e 'activate' -e 'end tell'
meh - e : osascript -e 'tell app "Finder"' -e 'make new Finder window to folder "Macintosh HD:Users:justin"' -e 'activate' -e 'end tell'

# Service
# semicolon
meh - 0x29 ; service
service < escape ; default

service < s : skhd -r; skhd -k "escape"
# service < p : paneru restart ; skhd -k "escape"
